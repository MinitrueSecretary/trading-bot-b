# ─── General ────────────────────────────────────────────────────────────────
BOT_LOG_LEVEL=INFO

# Set to false on Windows with a live MT5 account to send real orders
BOT_DRY_RUN=true

# ─── Symbols & Timeframe ─────────────────────────────────────────────────────
# Comma-separated MT5-format symbols (no "=X" suffix)
BOT_SYMBOLS=["EURUSD","GBPUSD","USDJPY"]
BOT_PRIMARY_SYMBOL=EURUSD

# Timeframe: 1m 5m 15m 30m 1h 4h 1d 1wk
BOT_TIMEFRAME=1h

# ─── Strategy ────────────────────────────────────────────────────────────────
# Options: sma_crossover | rsi | macd | rsi_divergence
BOT_STRATEGY_NAME=sma_crossover

BOT_SMA_FAST=20
BOT_SMA_SLOW=50

BOT_RSI_PERIOD=14
BOT_RSI_OVERBOUGHT=70
BOT_RSI_OVERSOLD=30

BOT_MACD_FAST=12
BOT_MACD_SLOW=26
BOT_MACD_SIGNAL=9

# ─── RSI Divergence strategy ─────────────────────────────────────────────────
BOT_STOCH_RSI_PERIOD=14
BOT_STOCH_RSI_K=3
BOT_STOCH_RSI_D=3
# How many recent bars to search for swing pivot pairs
BOT_RSI_DIVERGENCE_LOOKBACK=50
# Bars required on each side to confirm a swing pivot
BOT_RSI_DIVERGENCE_SWING_WINDOW=5

# ─── Risk Management ─────────────────────────────────────────────────────────
BOT_RISK_PER_TRADE_PCT=1.0
BOT_MAX_OPEN_TRADES=3
BOT_STOP_LOSS_PIPS=30
BOT_TAKE_PROFIT_PIPS=60

# ─── MT5 (Windows only) ──────────────────────────────────────────────────────
# BOT_MT5_LOGIN=12345678
# BOT_MT5_PASSWORD=your_password_here
# BOT_MT5_SERVER=YourBroker-Server
BOT_MT5_MAGIC=123456
BOT_MT5_SYMBOL_SUFFIX=m

# ─── Backtest output ─────────────────────────────────────────────────────────
# Save an interactive HTML chart to charts/ after each backtest run
BOT_BACKTEST_SAVE_CHART=true
# Save a trades CSV to trades/ after each backtest run
BOT_BACKTEST_SAVE_CSV=true

# ─── Discord ─────────────────────────────────────────────────────────────────
# BOT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
